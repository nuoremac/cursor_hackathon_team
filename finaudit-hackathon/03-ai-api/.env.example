# ---------------------------------------------------------------------------
# FinAudit AI API — environment configuration
# Copy this file to ".env" and fill in the values you need.
# Everything is OPTIONAL: with no keys the API uses the smart mock AI fallback.
# ---------------------------------------------------------------------------

# Which provider to use first: openai | gemini | mock
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Generation controls (deterministic, demo-friendly) ---
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=350
LLM_TIMEOUT_SECONDS=12

# --- CORS (comma separated; "*" allows everything) ---
CORS_ORIGINS=*
